<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#22d3ee</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0b1020</item>
        <item name="android:navigationBarColor">#0b1020</item>
        <item name="android:windowBackground">#0b1020</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">#0b1020</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/icon</item>
    </style>
</resources>
